{
  "defaults": {
    "accept_timeout_s": 600,
    "max_attempts": 3,
    "retry_delay_s": 30,
    "agent_timeout_s": 3600
  },
  "workers": [
    {
      "name": "openai",
      "provider": "openai",
      "model": "gpt-4o",
      "api_base": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "enabled": true,
      "cli": "pi"
    }
  ]
}
