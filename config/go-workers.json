{
  "workers": [
    {
      "name": "glm",
      "provider": "zai",
      "model": "glm-4.6",
      "cli": "pi",
      "api_key_env": "ZHIPUAI_API_KEY",
      "enabled": true
    }
  ],
  "defaults": {
    "max_attempts": 3,
    "agent_timeout_s": 1200,
    "accept_timeout_s": 300,
    "retry_delay_s": 5
  }
}
